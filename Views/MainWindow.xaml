<Window x:Class="AudioNode.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AudioNode" 
        Height="480" Width="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent">

    <Window.Resources>
        <!-- Button Styles -->
        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Foreground" Value="Transparent"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Circle -->
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="7" 
                                BorderBrush="#40000000" 
                                BorderThickness="0.5">

                            <TextBlock Text="{TemplateBinding Content}" 
                                       Foreground="{TemplateBinding Foreground}" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" 
                                       Margin="0,-1.5,0,0"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#80000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#1E1E1E" CornerRadius="12" BorderBrush="#333333" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" 
                    BorderBrush="#333333" 
                    BorderThickness="0,0,0,1" 
                    Background="Transparent" 
                    MouseDown="OnTitleBarMouseDown">
                <!-- Title Bar -->
                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnTitleBarMouseDown">

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,12,0">

                        <!-- Minimize Button -->
                        <Button Content="—" 
                            Style="{StaticResource WindowButton}" 
                            Background="#FFBD2E" 
                            Click="OnMinimizeClicked"/>

                        <!-- Close Button -->
                        <Button Content="✕" 
                            Style="{StaticResource WindowButton}" 
                            Background="#FF5F56" 
                            Click="OnCloseClicked"/>

                    </StackPanel>

                    <!-- Centered App Title -->
                    <TextBlock Text="AudioNode" 
                           Foreground="#888888" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center" 
                           FontWeight="SemiBold"/>

                </Grid>
            </Border>
            <!-- Main Content -->
            <Grid Grid.Row="1">
                <TextBlock Text="Main Content" 
                           Foreground="#555555" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>