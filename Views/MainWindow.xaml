<Window x:Class="AudioNode.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AudioNode" 
        Height="480" Width="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent">

    <Window.Resources>
        <!-- =============== Button Style =============== -->
        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Foreground" Value="Transparent"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Circle -->
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="7" 
                                BorderBrush="#40000000" 
                                BorderThickness="0.5">

                            <TextBlock Text="{TemplateBinding Content}" 
                                       Foreground="{TemplateBinding Foreground}" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" 
                                       Margin="0,-1.5,0,0"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#80000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- =============== Slider Style =============== -->
        <!-- The Thumb -->
        <Style x:Key="Thumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse x:Name="ThumbVisual"
                         Width="14" 
                         Height="14" 
                         Fill="#F0F0F0" 
                         Stroke="#E2725B" 
                         StrokeThickness="2" 
                         Cursor="Hand">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="0.3"/>
                            </Ellipse.Effect>
                        </Ellipse>

                        <ControlTemplate.Triggers>
                            <!-- Hover Effect -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbVisual" Property="StrokeThickness" Value="3"/>
                                <Setter TargetName="ThumbVisual" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3" Color="#E2725B"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <!-- Pressed Effect -->
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbVisual" Property="Fill" Value="#D1D1D1"/>
                                <Setter TargetName="ThumbVisual" Property="Stroke" Value="#B15A47"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filled Track -->
        <Style x:Key="TrackLeft" TargetType="RepeatButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" Background="#E2725B" CornerRadius="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Empty Track -->
        <Style x:Key="TrackRight" TargetType="RepeatButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" Background="#374151" CornerRadius="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Master Slider -->
        <Style TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" MinHeight="24">
                            <Track x:Name="PART_Track" Margin="7,0">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource TrackLeft}" Command="{x:Static Slider.DecreaseLarge}"/>
                                </Track.DecreaseRepeatButton>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource TrackRight}" Command="{x:Static Slider.IncreaseLarge}"/>
                                </Track.IncreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb Style="{StaticResource Thumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#1E1E1E" CornerRadius="12" BorderBrush="#333333" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" 
                    BorderBrush="#333333" 
                    BorderThickness="0,0,0,1" 
                    Background="Transparent" 
                    MouseDown="OnTitleBarMouseDown">
                <!-- Title Bar -->
                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnTitleBarMouseDown">

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">

                        <!-- Minimize Button -->
                        <Button Content="—" 
                            Style="{StaticResource WindowButton}" 
                            Background="#FFBD2E" 
                            Click="OnMinimizeClicked"/>

                        <!-- Close Button -->
                        <Button Content="✕" 
                            Style="{StaticResource WindowButton}" 
                            Background="#FF5F56" 
                            Click="OnCloseClicked"/>

                    </StackPanel>

                    <!-- Centered App Title -->
                    <TextBlock Text="AudioNode" 
                           Foreground="#888888" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center" 
                           FontWeight="SemiBold"/>

                </Grid>
            </Border>
            <!-- Main Content -->
            <Grid Grid.Row="1" Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Global Volume -->
                    <RowDefinition Height="20"/>
                    <!-- Spacing -->
                    <RowDefinition Height="*"/>
                    <!-- Scrollable App List -->
                </Grid.RowDefinitions>

                <!-- Global Volume -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="Global Volume" Foreground="#CCCCCC" FontWeight="SemiBold" Margin="7,0,0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <!-- The Slider -->
                        <Slider Grid.Column="0" Maximum="100" Value="50" VerticalAlignment="Center"/>
                        <!-- The Percentage -->
                        <TextBlock Grid.Column="1" Text="50%" Foreground="#888888" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>

                <!-- App List -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="AppListControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,15">
                                    <TextBlock Text="{Binding AppName}" Foreground="#CCCCCC" Margin="0,0,0,5"/>
                                    <Slider Maximum="100" Value="{Binding Volume}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>